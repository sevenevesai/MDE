    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "@vitest/coverage-v8": "^4.1.2",
    "cross-env": "^10.1.0",
    "jsdom": "^29.0.1",
    "rollup-plugin-visualizer": "^6.0.11",
    "tailwindcss": "^4.2.2",
